# Copy to `.env` and adjust. Restart `npm run dev` after changes.

# --- Homelab (optional) ---
VITE_PLEX_URL=
VITE_OVERSEERR_URL=
VITE_IMMICH_URL=
VITE_STASH_URL=

# --- API + Postgres (Railway: add these in the service variables) ---
DATABASE_URL=
# Random string, 32+ characters recommended
SESSION_SECRET=

# Production only: allow /api/auth/register for first account, then set back to false
ALLOW_OPEN_REGISTRATION=false

# Local API port (Vite proxies /api here)
PORT=8787
